{
  "name": "rackets",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sim": "vite-node scripts/headless.ts --",
    "sim2": "vite-node remake/scripts/headless.ts --"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
