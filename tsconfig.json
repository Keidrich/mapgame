{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@sim/*": ["sim/*"],
      "@content/*": ["content/*"],
      "@ui/*": ["ui/*"],
      "@geo/*": ["geo/*"],
      "@r/*": ["remake/*"]
    }
  },
  "include": ["sim", "content", "geo", "ui", "scripts", "remake", "vite.config.ts", "vitest.config.ts"]
}
